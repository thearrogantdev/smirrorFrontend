namespace widgetInternals;

table DashboardList {
  ids: [uint64];
}

table BusDeparture {
  hour: uint8;
  minute: uint8;
}

table BusLine {
  number: string;
  mon_fri: [BusDeparture];
  sat: [BusDeparture];
  sun: [BusDeparture];
}

table BusSchedule {
  lines: [BusLine];
}

table GoogleCaledarIDs {
  ids: [string];
}
